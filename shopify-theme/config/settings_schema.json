[
  {
    "name": "theme_info",
    "theme_name": "APOLOGEA NOCTURNE",
    "theme_version": "0.1.0",
    "theme_author": "APOLOGEA",
    "theme_documentation_url": "https://github.com/rfaelfox/apologea/tree/main/docs",
    "theme_support_url": "https://github.com/rfaelfox/apologea"
  },
  {
    "name": "Farben",
    "settings": [
      { "type": "paragraph", "content": "NOCTURNE: Nacht, Antikgold, Elfenbein. Weitere Töne werden automatisch abgeleitet." },
      { "type": "color", "id": "color_background", "label": "Hintergrund (Nacht)", "default": "#0b0a09" },
      { "type": "color", "id": "color_accent", "label": "Akzent (Antikgold)", "default": "#b8955a" },
      { "type": "color", "id": "color_text", "label": "Text (Elfenbein)", "default": "#ede5d4" }
    ]
  },
  {
    "name": "Typografie",
    "settings": [
      { "type": "font_picker", "id": "type_header_font", "label": "Überschriften", "default": "cormorant_n4" },
      { "type": "range", "id": "heading_letter_spacing", "label": "Laufweite Überschriften", "min": 0, "max": 40, "step": 2, "unit": "%", "default": 18 },
      { "type": "font_picker", "id": "type_body_font", "label": "Fließtext", "default": "inter_n4" }
    ]
  },
  {
    "name": "Animationen",
    "settings": [
      { "type": "checkbox", "id": "animations_enabled", "label": "Sacred-Cinematic-Animationen aktivieren", "default": true, "info": "Besucher mit reduzierter Bewegung (Systemeinstellung) sehen nie Animationen." },
      { "type": "checkbox", "id": "grain_enabled", "label": "Film-Körnung anzeigen", "default": true }
    ]
  },
  {
    "name": "Marke",
    "settings": [
      { "type": "image_picker", "id": "favicon", "label": "Favicon", "info": "Quadratisch, mindestens 64 × 64 px." },
      { "type": "text", "id": "brand_claim", "label": "Marken-Claim (Footer)", "default": "Luxury Christian Streetwear" }
    ]
  },
  {
    "name": "Produktkarten",
    "settings": [
      { "type": "checkbox", "id": "card_show_secondary_image", "label": "Zweites Bild beim Hover zeigen", "default": true },
      {
        "type": "select", "id": "card_image_ratio", "label": "Bildformat",
        "options": [
          { "value": "portrait", "label": "Hochformat 4:5" },
          { "value": "square", "label": "Quadratisch" },
          { "value": "tall", "label": "Hoch 2:3" }
        ],
        "default": "portrait"
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      { "type": "paragraph", "content": "Leer lassen, um ein Netzwerk auszublenden." },
      { "type": "url", "id": "social_instagram", "label": "Instagram" },
      { "type": "url", "id": "social_tiktok", "label": "TikTok" },
      { "type": "url", "id": "social_youtube", "label": "YouTube" },
      { "type": "url", "id": "social_pinterest", "label": "Pinterest" }
    ]
  }
]
