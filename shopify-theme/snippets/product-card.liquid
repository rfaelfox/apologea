{%- comment -%} Parameter: product, eager (bool) {%- endcomment -%}
{%- liquid
  case settings.card_image_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'tall'
      assign ratio = '2 / 3'
    else
      assign ratio = '4 / 5'
  endcase
  assign loading = 'lazy'
  if eager
    assign loading = 'eager'
  endif
  assign img2 = product.media[1]
-%}
<article class="card" style="--card-ratio: {{ ratio }};">
  <div class="card__media">
    {%- if product.available == false -%}
      <span class="card__badge">{{ 'products.sold_out' | t }}</span>
    {%- elsif product.compare_at_price > product.price -%}
      <span class="card__badge">{{ 'products.sale' | t }}</span>
    {%- endif -%}
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 900 | image_tag:
        loading: loading,
        widths: '360,540,720,900',
        sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 50vw',
        alt: product.featured_media.alt | default: product.title,
        class: 'card__img--1'
      }}
      {%- if settings.card_show_secondary_image and img2 and img2.media_type == 'image' -%}
        {{ img2 | image_url: width: 900 | image_tag:
          loading: 'lazy',
          widths: '360,540,720,900',
          sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 50vw',
          alt: '',
          class: 'card__img--2'
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-apparel-1' | placeholder_svg_tag: 'card__placeholder' }}
    {%- endif -%}
  </div>
  <div class="card__meta">
    <h3 class="card__title">
      <a class="card__link" href="{{ product.url }}">{{ product.title | escape }}</a>
    </h3>
  </div>
  {% render 'price', product: product %}
</article>
