<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ shop.name }}</title>
    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    {% render 'css-variables' %}
    {{ 'nocturne.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'nocturne.js' | asset_url }}" defer="defer"></script>
    {{ content_for_header }}
  </head>
  <body class="template-password{% unless settings.animations_enabled %} no-motion{% endunless %}{% if settings.grain_enabled %} has-grain{% endif %}">
    <main id="MainContent" class="main" role="main">
      {{ content_for_layout }}
    </main>
    {%- if settings.grain_enabled -%}
      <div class="grain" aria-hidden="true"></div>
    {%- endif -%}
  </body>
</html>
