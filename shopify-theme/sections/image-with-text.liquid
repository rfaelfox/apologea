<section class="section{% if section.settings.alt_bg %} section--alt{% endif %}" style="{% render 'section-spacing', s: section.settings %}">
  <div class="container split{% if section.settings.reverse %} split--reverse{% endif %}">
    <div class="split__media reveal-fade">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600,900,1200,1400', sizes: '(min-width: 990px) 50vw, 100vw' }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
    <div class="split__text reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      <div class="rte muted">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}
        <a class="btn" href="{{ section.settings.button_link | default: '#' }}" style="margin-top: 16px;">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bild mit Text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Bild" },
    { "type": "checkbox", "id": "reverse", "label": "Bild rechts", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Unsere Geschichte" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Glaube, getragen" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Hier die Markengeschichte von APOLOGEA eintragen.</p>" },
    { "type": "text", "id": "button_label", "label": "Button-Text", "default": "Mehr erfahren" },
    { "type": "url", "id": "button_link", "label": "Button-Link" },
    { "type": "checkbox", "id": "alt_bg", "label": "Abgesetzter Hintergrund", "default": true },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 112 }
  ],
  "presets": [{ "name": "Bild mit Text" }]
}
{% endschema %}
