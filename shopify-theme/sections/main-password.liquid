<section class="hero" style="--hero-h: 100svh;">
  <div class="hero__media"><div class="hero__placeholder"></div></div>
  <div class="hero__rays" aria-hidden="true"></div>
  <div class="hero__content">
    <p class="eyebrow reveal">{{ 'password.eyebrow' | t }}</p>
    <h1 class="password-logo reveal" style="--reveal-delay: 150ms;">
      <img src="{{ 'apologea-logo.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="420" height="204" loading="eager">
    </h1>
    {%- if shop.password_message != blank -%}
      <p class="hero__sub reveal" style="--reveal-delay: 300ms;">{{ shop.password_message | escape }}</p>
    {%- endif -%}

    <div class="reveal" style="--reveal-delay: 450ms;">
      {%- form 'customer', class: 'newsletter' -%}
        <input type="hidden" name="contact[tags]" value="prospect,password page">
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" role="status">{{ 'newsletter.success' | t }}</p>
        {%- endif -%}
        <div class="newsletter-form">
          <label class="visually-hidden" for="PwNewsletter">{{ 'newsletter.label' | t }}</label>
          <input class="input" id="PwNewsletter" type="email" name="contact[email]" required placeholder="{{ 'newsletter.label' | t }}">
          <button class="btn btn--solid" type="submit">{{ 'newsletter.button' | t }}</button>
        </div>
      {%- endform -%}

      <details style="margin-top: 32px;">
        <summary class="muted small" style="cursor: pointer;">{{ 'password.enter' | t }}</summary>
        {%- form 'storefront_password' -%}
          {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors | default_errors }}</p>{%- endif -%}
          <div class="newsletter-form" style="margin-top: 16px;">
            <label class="visually-hidden" for="Password">{{ 'password.label' | t }}</label>
            <input class="input" id="Password" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}">
            <button class="btn" type="submit">{{ 'password.submit' | t }}</button>
          </div>
        {%- endform -%}
      </details>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Passwortseite", "settings": [] }
{% endschema %}
