<section class="section" style="{% render 'section-spacing', s: section.settings %}">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-head section-head--center reveal">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}
    <div class="grid grid--3 reveal--stagger">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <a class="tile" href="{{ c.url | default: '#' }}" {{ block.shopify_attributes }}>
          {%- assign img = block.settings.image | default: c.featured_image -%}
          {%- if img -%}
            {{ img | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,600,800,1000', sizes: '(min-width: 750px) 33vw, 50vw', alt: c.title | default: '' }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}
          <div class="tile__label">
            <h3>{{ block.settings.title | default: c.title | default: 'Kollektion' | escape }}</h3>
            <span class="link-arrow">{{ 'general.discover' | t }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kollektionen",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Entdecken" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Kollektionen" },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 112 }
  ],
  "blocks": [
    {
      "type": "collection", "name": "Kollektion",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Kollektion" },
        { "type": "text", "id": "title", "label": "Titel (optional)" },
        { "type": "image_picker", "id": "image", "label": "Bild (optional)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Kollektionen", "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }] }]
}
{% endschema %}
