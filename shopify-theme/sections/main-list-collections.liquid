<section class="collection-hero container reveal">
  <h1>{{ 'collections.all' | t }}</h1>
  {% render 'ornament' %}
</section>
<section class="section" style="--pt: 0px; --pt-d: 0px;">
  <div class="container grid grid--3 reveal--stagger">
    {%- for c in collections -%}
      <a class="tile" href="{{ c.url }}">
        {%- if c.featured_image -%}
          {{ c.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,600,800,1000', sizes: '(min-width: 750px) 33vw, 50vw', alt: c.title }}
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag }}
        {%- endif -%}
        <div class="tile__label">
          <h2 class="h3">{{ c.title | escape }}</h2>
          <span class="link-arrow">{{ 'general.discover' | t }}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{ "name": "Kollektionsliste", "settings": [] }
{% endschema %}
