<section class="section section--alt" style="{% render 'section-spacing', s: section.settings %}">
  <div class="container container--narrow center reveal">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h2>{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<div class="rte muted">{{ section.settings.text }}</div>{%- endif -%}
    {%- form 'customer', id: 'NewsletterForm', class: 'newsletter' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">{{ 'newsletter.success' | t }}</p>
      {%- elsif form.errors -%}
        <p class="form-message form-message--error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
      {%- endif -%}
      <div class="newsletter-form">
        <label class="visually-hidden" for="NewsletterEmail">{{ 'newsletter.label' | t }}</label>
        <input class="input" id="NewsletterEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.label' | t }}">
        <button class="btn btn--solid" type="submit">{{ 'newsletter.button' | t }}</button>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Gemeinschaft" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Bleib im Licht" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Neue Drops und Geschichten zuerst erfahren.</p>" },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
