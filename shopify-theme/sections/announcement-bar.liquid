{%- if section.settings.text != blank -%}
  <div class="announcement" role="region" aria-label="{{ 'general.announcement' | t }}">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
    {%- else -%}
      {{ section.settings.text | escape }}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Ankündigungsleiste",
  "class": "section-announcement",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Willkommen bei APOLOGEA" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Ankündigungsleiste" }]
}
{% endschema %}
